const promptDataPago = [
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_001.jpg", prompt: "Creative photo session\n\nWe generate you in a shirt against the background of a collage using this prompt:\n\n\nmodern editorial collage poster design. the background features four stacked rounded panels filled with black and white cinematic portraits of a stylish young person in different fashion poses. overlayed in the foreground is a high-quality full-color cutout of the same person wearing a red oversized shirt with black pants and sunglasses, striking a confident fashion pose. clean minimal design, no text, no typography, no letters, soft shadows, depth layering, high contrast lighting, premium magazine style, ultra realistic, 8k, professional poster composition." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_002.jpg", prompt: "Photo with peonies\n\nWe generate a beautiful photo with flowers using this prompt:\n\n\nUse the uploaded photo for your face, keep all features exactly: appearance, age, hair, eyes, skin tone and texture, facial proportions - do not change even 1%. The shot is hip-length, the body half-turned, looking straight into the camera - confidently feminine. The hair is in soft voluminous waves, individual strands are highlighted. Makeup: radiant tone, contouring of cheekbones, brown shadows with shading, thin liner, long eyelashes, nude lips. Medium size gold hoop earrings. Soft pink bodycon dress made of textured knit midi with open shoulders and neck - perfect for the figure, the texture of the knit is visible. In both hands there is a huge armful of snow-white peonies with voluminous lush buds and long green stems - the bouquet occupies the lower half of the frame. Light shine on collarbones and shoulders. Location: minimalistic modern courtyard - white pebbles on the ground, olive trees, matte black wall in the background. In the foreground, softly blurred leaves create depth. Diffused soft daylight, no hard shadows. Skin pores, realistic texture of knitting and peony petals, slight shine on the collarbones, natural sharpness of the face. Premium color correction: clean neutral with a slight warm shift, white peonies as a bright accent. Shot on an iPhone, realistic frame depth, light grain, no beauty filter, 9:16 format. Save your appearance, hair, eyes, age, skin tone and texture strictly from the uploaded photo - identical to the original" },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_003.jpg", prompt: "Photo from the spaceship\n\nWe generate a photo in a spacesuit in space using this prompt:\n\n\nA cinematic, medium close-up shot of a young woman as in <<<image_1>>> standing in profile, gently resting her forehead against the metallic black visor of an off-white, mobile suit pilot helmet held in her gloved hands. She wears a detailed, futuristic white mobile suit pilot suit with subtle signs of wear and tear, including scuffs and grime textures. The lighting is soft, cool, and diffused, creating a melancholic and introspective mood with a palette of pale blues, stark whites, and pops of muted grey. The background is a blurred, minimalist sci-fi interior with sterile, light-toned architecture. Shot on a 85mm lens with a shallow depth of field, focusing sharply on her face and the texture of the helmet, high-quality digital photography, hyper-realistic, intricate details, soft cinematic highlights, ethereal atmosphere. Loose messy hair style. Visor should have no reflection of the photographer." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_004.jpg", prompt: "Photo with a bouquet in a cafe\n\nWe generate a photo in a very beautiful dress to match the color of the bouquet in a cafe using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Spontaneous photo on iPhone. Cinematic effect with grain. A woman with a smooth low bun, her head turned towards the bouquet, a look at the bouquet, a soft smile, a feeling of the real moment. One hand supports the cheek. Neat makeup: Long eyelashes, glossy lips. Stud earrings, cuff, thin chain with a cross, large watch. Pink satin dress with thin straps. A woman sits next to a huge bouquet of pink spray roses in a soft pink package, the bouquet occupies the lower right corner. Expensive street restaurant. The warm light of the golden hour, the natural, unstaged aesthetics of a smartphone, film grain, no retouching. Vertical format 9:16. --ar 9:16 --raw --style motion 50. Milky manicure, almond." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_005.jpg", prompt: "Photo at sunset\n\nWe generate a very aesthetic photo in which you hold the sun at sunset using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Preserve the face and silhouette from the reference as realistically as possible. The girl stands with her back to the camera on a stone pier by the sea, her head is turned to the right, her profile is visible. Looking at the sunset. The right hand is extended towards the horizon, the fingers are positioned as if holding the sun. The left shoulder is slightly exposed by a slipped white loose linen shirt, a light short skirt with ruffles and a thin gold chain. Beach curls hair. A bright sea sunset with backlight: the silhouette is slightly darkened, the contours of the face, shoulders and arms are highlighted with a warm orange glow. Rich gold, orange and deep blue shades, an endless sea with a sunny path, clouds illuminated from below, a textured stone pier. Soft medium shot from the back, sharp focus, cinematic atmosphere of the golden hour, high detail." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_006.jpg", prompt: "Photo in the park\n\nWe generate a photo on a park bench under a flowering tree using this prompt:\n\n\nKeep facial features unchanged, 100% similarity. Ultra-realistic photo on a smartphone. A girl sits on a light wooden bench in the park at night. Hair in beautiful waves. One hand lightly touches the hair, the head is turned to the right, the gaze is directed to the side, past the camera, a slight half-smile, long eyelashes, gloss on the lips. She is wearing a long, tight-fitting white dress with thin straps, silver high-heeled sandals, and a small silver clutch next to her. Behind are lush blooming trees with thick pink flowers, illuminated from below by the warm light of park lanterns, creating a beautiful contrast with the dark sky. In the background you can see green trees and elements of a park or embankment. Atmospheric night photography with soft warm lighting, slight natural blur and soft focus typical of a smartphone shot" },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_007.jpg", prompt: "Gorgeous evening photo\n\nWe generate a very beautiful evening photo using this prompt:\n\n\nCinematic photorealistic portrait of a young woman, vertical 3:4 format.\n\nThe woman is sitting in the grass by the sea at night. In the background is a dark ocean, light mist, and a deep blue-black night sky. In the foreground, tall grass is softly out of focus to create a natural sense of depth.\n\nShe is wrapped in a white blanket with her shoulders exposed. She hugs herself with both arms, her head slightly tilted back, her eyes closed, and a calm, peaceful expression on her face.\n\nHer very long loose hair gently flows in the breeze.\n\nShot with direct flash at night: a bright on-camera flash illuminates the woman while the background remains dark. Her skin has a luminous, slightly wet look on her face, shoulders, and collarbones.\n\nSharp focus on the face and hair, ultra-high skin detail with natural pores and realistic texture, free of plastic or overly retouched skin.\n\nRAW camera aesthetic, sharp focus, cinematic night photography, subtle film grain, realistic digital noise, natural contrast, no AI look.\n\nAspect ratio: 3:4." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_008.jpg", prompt: "Photo on a yacht\n\nWe generate a male photo shoot from a yacht using this prompt:\n\n\nUse the uploaded photo for your face, keep all features exactly: appearance, age, hair, eyes, skin tone and texture, facial proportions - do not change even 1%. Shot from the waist up, a man sits relaxed on the bright deck of a yacht - holding a glass of champagne in one hand, a free, confident pose. The athletic build can be seen under the clothes. Dark brown loose linen shirt, white linen trousers - natural fabrics with visible linen texture. Canon G7X direct flash: characteristic bright highlights on the face, hands, shirt fabric and glass of champagne - slight overexposure in the foreground. The warm golden sunset light of golden hour mixes with the flash - a warm halo along the contour of the silhouette. The background remains darker and more cinematic: a light, minimalistic yacht deck, a deep dark blue sea with ripples, a dramatic evening sky with a clear horizon line - a warm sunset at the horizon turns into a dark blue above. The glare of a flash on a glass of golden champagne. Color palette: dark brown linen, white trousers, dark blue sea, golden sunset. Canon G7X compact camera aesthetic, lively spontaneous shot, characteristic grain of a compact camera, warm toning, no beauty filter, 9:16 format. Keep your appearance, hair, eyes, age, skin tone and texture strictly from the uploaded photo - identical to the original." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_009.jpg", prompt: "Photo with a flower\n\nWe generate a photo underwater with a beautiful pink flower using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Cinematic portrait of a girl with fine grain. She is in sea water up to her shoulders and her clothes are not visible. He holds in his hand a beautiful soft pink southern large flower near his face. The hair is wet and combed back. Daylighting with dimming. Background is out of focus. Looking at the camera" },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_010.jpg", prompt: "On the balcony by the ocean\n\nWe generate an aesthetic photo by the ocean using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Ultra-realistic lifestyle photo. A girl on a balcony by the ocean, almost at full height, looks relaxed to the left. A careless voluminous bun with light bangs and loose strands. Light blue knitted off-shoulder mini dress with long sleeves, cream clutch on gold chain. Silver railings, dark blue ocean with waves, cloudy blue sky. Soft diffused light, cool palette, vibrant skin with pores, quiet luxury, without AI effect." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_011.jpg", prompt: "Photo near the cathedral\n\nWe generate a beautiful photo in Moscow with the cathedral in the background using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Filmed on iPhone. Selfie in Moscow. Dear Russian aesthetics. A girl in front of St. Basil's Cathedral in Moscow. Realism. A low-angle selfie composition, the cathedral rises sharply into the night sky behind her. The head is slightly tilted towards the shoulder and down with the chin towards the neck. Voluminous hair is thrown to one side. Length of hair under the collar of the jacket. She is wearing a black leather jacket with straight shoulders. On the eyes are small, narrow, rimless sunglasses. Don't blur the background. The raindrops are slightly visible on the jacket. Shot with flash in the dark." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_012.jpg", prompt: "Broken mirror\n\nWe generate a photo with a reflection in a broken mirror using this prompt:\n\n\nUse the exact same face from the reference image and generate a dark cinematic portrait with a concept that has never appeared in this entire series \u2014 the subject seen through the fractured geometry of a shattered mirror, the face multiplied and fragmented across dozens of broken mirror shards, each piece reflecting a slightly different angle of the same face simultaneously.\n\nThe subject positioned close and directly in front of a massive shattered mirror \u2014 the mirror surface broken into dozens of irregular fragments still held within their frame, each shard at a slightly different angle from the impact, each one catching and reflecting the face from a completely different perspective simultaneously. Some shards showing the full eye, others just the jaw, others a slice of the nose bridge, others reflecting only darkness or the cold key light source \u2014 the shattered mirror one face turning into a fractured mosaic of itself, simultaneously showing every angle of the same human face that a single photograph could never capture.\n\nThe largest central shard holds the most complete reflection \u2014 the face closest to straight on, the primary portrait within the portrait, eyes staring back through the broken glass with absolute still intensity. Surrounding shards fragmenting outward from the center each capturing a different sliver of the same face at different angles \u2014 some shards showing the face from slightly left, others from slightly right, some from above, some just catching the eye or the lip or the cheekbone in isolation. The fracture lines between shards - dark voids of absolute black between the glass pieces - creating a graphic web of darkness across the reflected face, dividing it into geometric fragments.\n\nThe mirror shards themselves are rendered at obsessive physical detail \u2014 the glass edges sharp and precisely fractured, some edges showing the thickness of the mirror glass as a thin silver line, the reflective silver backing of the mirror visible at broken edges, some shards showing tiny concentric crack lines radiating from the impact point, the glass surface of each shard catching its own micro-reflections and slight surface imperfections. Some smaller shards at the periphery having fallen slightly from the frame leaving dark rectangular voids in the mirror surface \u2014 negative spaces where reflection once existed." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_013.jpg", prompt: "Collage with peonies\n\nWe generate a beautiful collage with fresh flowers using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. A realistic collage of three selfies: the girl in the center of each frame takes a selfie and holds a bouquet of pink peonies. Top frame: body straight, glance to the side - to the right, slight smile. Smartphone in right hand near face. Medium: body turned, head straight, looking into the lens with a gentle smile. Smartphone at chin level. Lower: the body is slightly tilted forward, the head is turned to the left, the lips are closed in a kiss. Smartphone at chest level. Nude manicure. She's wearing a black ribbed jersey top with thin straps. Loose wavy hair. Background: beige wall, soft peach curtain. Post-processing: fine HDR, color correction (+20K), film grain 2%, sharpening on smartphone details and fabric texture, cozy cinematic look. visible pores, no plastic skin, no AI smoothing." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_014.jpg", prompt: "Photo on a board at sea\n\nWe generate a beautiful photo by the sea on a surfboard using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Photorealistic fashion portrait of a young woman on the ocean at sunset. Tanned skin with a dewy glow, wet hair standing straight behind her back. She is kneeling on a board by the water, looking left in profile, eyes closed, calm expression; both hands touch the hair behind the head. Black laconic bandage swimsuit. Calm sea, low horizon, smoky orange sky and soft sun overhead. Warm backlighting, light light on the face, cinematic contrast and soft haze. Premium beach-editorial photography, sharp subject, blurred background, shallow depth of field, warm orange-golden color correction. Medium-full shot from knees to head, camera low on the water, lots of open space in the sky. No anatomy distortion, extra fingers/limbs, blur, CGI, text, logos or watermarks." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_015.jpg", prompt: "Photo near the car with balls\n\nWe generate a creative photo near a car with toy balls using this prompt:\n\n\nConceptual editorial photography.\nvertical 2:3 everyday\nabsurdity with chromatic injection, hyper-realistic, deadpan humor, film finish COMPOSITION: three clearly separated horizontal bands - sky occupying the top 40%, an industrial building and the car across the middle 35%, and a sea of plastic balls across the asphalt in the bottom 25%. MAIN SUBJECT: a man (face of the reference person) standing beside the open driver's door of a battered car, body facing forward but HEAD TURNED AND TILTED UPWARD with an expression of weary resignation - the unmistakable \"why me\" look. One hand grips the door frame, the other holds a brown loather BRIEFCASE.\nHis posture is stiff and contained; he is not reacting dramatically, he is simply standing there accepting It. OUTFIT\n- the conceptual contrast: a cream-beige Harrington jacket, a white dress shirt, a black and white patterned tie, dark gray dress trousers and plain leather shoes. An entirely conventional office uniform, and that formality is what makes the chaos around him absurd. THE CAR: a weathered mustard-orange compact sedan from the late 1980s, rusted and dented with a sagging bumper and a yellow decorative side stripe, spare tires stacked on the roof. Its interior is COMPLETELY PACKED WITH BALLS UP TO THE CEILING, clearly visible through the rear window. THE BALLS: hundreds of matte plastic spheres in pink. green, blue, orange, yellow, purple and turquoise, POURING OUT of the open door in a cascade and then scattering across the asphalt in a progressively thinning distribution toward the foreground - this density gradient is what creates depth and suggests recent motion.\nSETTING: a modest Industrial\ncomplex - white and teal corrugated metal warehouse units. roller garage doors, a numbered panel on the right wall, a beverage vending machine on the left, and cracked asphalt.\nTurquolse blue sky with scattered cumulus clouds. LIGHTING direct midday sun from high and alightly right, casting hard defined shadows beneath the car and beneath EVERY\nINDIVIDUAL\nBALL - each throwing sphere Its own small\nshadow, which is what convincingly anchors them to the ground. High contrast. Palette: deliberate structural contrast - the environment in muted neutrals of beige, gray, dirty white and Industrial teal under a desaturated turquoise sky. and against that the SATURATED PRIMARY COLORS of the balls explode. All the color in the frame is confined to a single type of object. Shot on 35-50mm at chest height, pure frontal, deep depth of fleld with everything sharp from the foreground balls to the clouds. Fine film grain, medium-high contrast, selective safuration, slight green cast in the shadows, no logos, no brand names, 8k." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_016.jpg", prompt: "Photo in the mirror\n\nWe generate a home photo in the mirror using this prompt:\n\n\n@image_1 - exact reference for the model. Preserve her appearance 1:1: face, features, skin tone, hair, age, and body proportions. Create an ultra-realistic 4:5 mirror selfie. The model is in a deep squat in front of a large floor mirror: one knee raised, the other leg bent under her body. In her right hand, she holds a light-colored smartphone near her face; in her left, a dark brown clutch.\nShe is wearing a long sand-beige open-knit crochet dress with thin straps and a deep V-neckline, without a belt. Cream high-heel sandals with a thin stiletto heel, chunky bracelets, and long earrings. Her hair is straight and sleek.\nLight wall, gray carpeted floor, wooden mirror frame. Soft daylight, accurate reflection, natural anatomy. Skin must look as alive as possible: visible pores, slight imperfections, natural glow, with no filters and no heavy retouching.\nStyle: photorealistic smartphone mirror selfie, candid luxury fashion, realistic crochet texture, soft daylight, HDR.\nNegative prompt: altered face, mixed identity, plastic skin, wrong pose, distorted mirror, warped phone, deformed hands, extra fingers, fused legs, incorrect heels, different dress, belt, missing clutch, cartoon, text, logo, watermark, UI." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_017.jpg", prompt: "Photo by the sea\n\nWe generate a very beautiful photo by the sea using this prompt:\n\n\n@image_1 - exact reference for model and composition. Preserve her appearance 1:1: face, features, skin tone, hairstyle, figure, and proportions. Skin must be maximally natural: real pores, slight imperfections, fine hairs, and natural highlights, without beauty filters or plastic retouching. Create an ultra-realistic vertical fashion portrait 9:16 on a snowy-white tropical beach during the soft evening hour. The model sits on the sand with her back to the camera, one leg bent, torso slightly turned, head turned over the shoulder, calm confident gaze directed into the lens. She wears a long semi-transparent knitted dress in a muted silver-olive shade with thin straps and a very deep open back neckline. The fabric naturally hugs the figure, softly gathers in folds on the sand, and shows a realistic lace-like texture. Minimalist gold earrings, straight hair lies freely. Background: calm turquoise water, clean light sand, pastel sky with tender lilac-pink and blue shades. Warm sunset light softly illuminates the skin and body contours, slight cool ambient light from the sea, natural shadows, calm luxury-resort atmosphere. Camera at the level of the sitting model, angle from behind in 3/4, focus on face, open back, and dress texture, soft horizon blur, 85mm lens, shallow depth of field, cinematic color grading, luxury beach editorial, quiet elegance, photorealistic, HDR, 8K. Negative prompt: altered face, plastic skin, heavy retouching, wrong pose, closed-back dress, opaque fabric, distorted anatomy, extra limbs, deformed hands, unnatural spine, warped dress pattern, wet hair, harsh sunlight, crowded beach, buildings, props, text, watermark, UI." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_018.jpg", prompt: "Night photo by the sea\n\nWe generate an aesthetic photo next to a car on the seashore using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. The camera is opposite the trunk and the girl, she is looking straight into the camera. A girl sits on the edge of the open trunk of a Mercedes 222 AMG black without license plates on the street. She is wearing loose blue jeans, white sneakers, a tight white long sleeve with a deep cut on top and a cropped huge burgundy bomber jacket. The girl sits on the edge of the open trunk, her legs calmly hanging down. Hands in jacket pockets. The head is tilted back. Hair falls on your face from the wind. Looking into the distance at the orange dark sunset, the photo was taken from the side. Only part of the car is visible in the frame, the open trunk. The photo shows a car with an open trunk parked on the seashore. Shot on a canon g7x with flash. French square manicure. The shoes are not visible. Filmed in the dark" },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_019.jpg", prompt: "On the tennis court\n\nWe generate a photoset on a tennis court using this prompt:\n\n\nUse the uploaded image as the SINGLE model reference. The woman in the photo is the exact model. Preserve her appearance with absolute precision. Identity Lock is the top priority. The face must be 100% identical to the reference. Do not change, improve, stylize, change age, or alter any facial features. Preserve exact eyes, eyebrows, eyelashes, nose, lips, jawline, cheekbones, ears, skin tone, facial proportions, expression, hairstyle, hairline, body proportions, and overall look. No deviations from the original.\nCreate a luxurious editorial lifestyle-fashion photograph on an outdoor tennis court. The model sits naturally on the court surface next to a tennis net: one leg bent, the other freely extended, a relaxed and elegant pose. She holds a bright yellow tennis ball near her ear as if talking on the phone, looking thoughtfully to the side. Several tennis balls are naturally scattered around her on the court.\nShe wears a black sleeveless tennis dress, a black Nike visor with a white logo, white Nike socks, and chunky white tennis sneakers. Minimal jewelry. Hair lies freely on her shoulders.\nWarm golden hour light, cinematographic lighting, soft shadows, shallow depth of field, atmosphere of expensive fashion editorial shooting, premium sportswear advertising campaign, natural skin texture with visible pores, ultra-realistic hair strands, rich contrast, soft bokeh, 85mm lens, aperture f/1.8, medium format camera quality, Vogue style, Harper's Bazaar, Saint Laurent Campaign, Nike Women Campaign, ultra-photorealism, HDR, 8K, masterpiece, award-winning fashion photography.\nNegative prompt: different face, identity change, face drift from reference, altered facial features, different hairstyle, different body proportions, different skin tone, beauty filter, plastic skin, heavy makeup, cartoon style, CGI, illustration, anime, low quality, blurriness, extra fingers, distorted hands, cropped body, body duplication, face duplication, watermark, logo, text." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_020.jpg", prompt: "Photo by the Mediterranean Sea\n\nWe generate a photo in a cafe near the Mediterranean Sea using this prompt:\n\n\n@Image1 - Exact model reference. Use the uploaded photo as the exact reference for the model. Preserve the appearance 1:1: facial features, eye shape and color, nose, lips, natural skin tone, body proportions, natural facial expression, gaze, and identity. Do not alter the model's face or appearance.\nThe woman from @Image1\u00a0is seated at a luxurious seaside caf\u00e9 overlooking the crystal-clear Mediterranean Sea, enjoying a cup of freshly brewed espresso. She is wearing an elegant light blue off-the-shoulder blouse, light-wash premium denim jeans, layered gold jewelry, and a white designer handbag. Her long, voluminous hair with soft natural sun-kissed highlights is styled in luxurious loose beach waves with a deep side part. The hair has natural root volume, a silky texture, healthy shine, and gently flows in the warm Mediterranean breeze, with a few delicate strands softly framing her face. In the background are turquoise waters, elegant white yachts, Mediterranean pine trees, and a refined coastal atmosphere.\nLifelike skin with visible pores and natural micro-texture, realistic fabric details, soft creamy bokeh, cinematic color grading, rich dynamic range, authentic sunlight, subtle reflections, and premium editorial lighting.\nJacquemus Campaign. Dior Riviera. Loro Piana Summer. Brunello Cucinelli Resort. Vogue Greece Editorial. Harper's Bazaar. Quiet Luxury. Mediterranean Lifestyle. Ultra Photorealistic. Full-Frame Camera. 85mm Lens. Kodak Portra 160. HDR. 8K.\nNegative Prompt: different face, altered appearance, short hair, straight hair, different hair color, lack of volume, plastic skin, CGI, artifacts, blur, text, logos, watermarks, low quality." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_021.jpg", prompt: "Sunset on the sea\n\nWe generate a beautiful collage with a sunset at sea using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. An expensive lifestyle moment captured on an iPhone 15 by chance, like a story. Photorealism, raw photo. Vertical triptych of three horizontal frames. Evening beach after sunset (blue hour), cold shades, a girl knee-deep in water at the surf line, wet sand, calm sea. Each frame has different natural movements: shooting from the back, in 3/4, in the last frame looking into the camera, the face is partially hidden by hair. Loose white oversized Chrome Hearts cotton T-shirt, lightly dampened, hip length. Light step in the water, relaxed posture. Hard smartphone flash, almost complete darkness, bright foreground, dark background, cold digital light, slight noise early 2000s. A narrow pink-violet stripe of sunset on the horizon, a calm dark sea. Aesthetics: candid beach moment, tumblr aesthetic, cinematic realism. Large frame, 35 mm, high ISO, light grain, no bokeh." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_022.jpg", prompt: "Photo at the waterfall\n\nWe generate a very aesthetic photo at a waterfall using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. The skin is damp from drops of water and fog. Hair is loose and damp. Light makeup: glossy lips with a brown outline, long eyelashes, delicate highlighter. Black swimsuit with cutouts, stud earrings, thin gold bracelet, milky manicure. A woman sits on a wet stone by a waterfall, her legs are extended and crossed at the ankles, her left hand is raised up, palm up, as if catching drops, her right hand is leaning back, her head is thrown back strongly, her eyes are closed. Tropical forest, majestic cascading waterfall, wet stones, fog. Soft diffused light. iPhone photo, casual lifestyle, Instagram/Pinterest aesthetic, RAW, light film grain, low exposure, sharp background, medium shot, full face, hyperrealism, 8K.\n\n\n\n\nKS" },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_023.jpg", prompt: "Stylish photo\n\nWe generate photos with futuristic mirror sculptures using this prompt:\n\n\nTransform this image into a premium surreal fashion editorial while preserving the person's identity, facial features, hairstyle, skin tone, outfit, pose, body proportions, and camera angle exactly as they are. Do not replace any clothing,accessories, or facial details.Keep the subject perfectly sharp,photorealistic, and naturally blended.Create a realistic composition by surrounding the subject with large organic liquid chrome structures inspired by flowing metal, abstract biomorphic shapes, and futuristic sculptures. The chrome should appear to grow naturally around the subject without covering important body parts or the face. Add realistic reflections, soft shadows, depth, and perspective so the metallic forms feel physically present.Maintain a clean minimal background while integrating the chrome elements into the environment. Use soft natural daylight with cinematic contrast and subtle highlights Keep a luxury fashion magazine aesthetic similar to Vogue, Num\u00e9ro, and Highsnobiety editorials.Preserve the original colors of the clothing and skin. Do not add extra people, text, logos, watermarks, or unnecessary objects. The final image shoule feel like a high-end Al fashion, campaign with ultra-realistic details, crisp textures, HDR quality, 8K resolution, editoria ) Made with Edits position, premium color grading, dramatic depth of field, and professional commercial photography." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_024.jpg", prompt: "Stylish photos in the subway\n\nLet's generate a cool photo on an escalator using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Filmed on iPhone. Low angle, camera from below on an escalator, hips leaning forward, one arm bent at the elbow, a black quilted bag on a Chanel chain with silver fittings on the elbow, the other resting on the railing. The girl is wearing a tight-fitting T-shirt with a deep round neckline, black buggy jeans with a low rise, loose oversized straight. Background escalator in the subway/passage, metal handrails, steps, tiles, service signs in the distance, ceiling panels, people. The hair is brushed and thrown to one side over the shoulder. On the eyes there are small black oval glasses without frames. Skin slightly tanned. French manicure. On my hand is an expensive small women's steel watch. Low exposure, subdued warm light, shot with flash in the dark. Don't blur the background." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_025.jpg", prompt: "Photo in the car\n\nWe generate a blurry photo in the car using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Photorealistic night shot inside a car. The girl is sitting in the front passenger seat, shot in profile slightly from behind, body to the left, head thrown back, fingers at the neck, face indistinguishable due to strong motion blur. She is wearing a shining evening set in light silver color: a tight-fitting sleeveless top with a high neckline and a mini skirt, completely covered with rhinestones. Wide bracelet made of large rhinestones, long light nails. Random photo on a phone in a moving car, natural motion blur, slight defocus, low light, warm flash emphasizes skin, fabric and jewelry, background almost black. Outside the window there are blurry pink and purple neon lights and dark greenery. Dark interior, grainy smartphone, muted black and brown tones, sparkling highlights, close angle to the waist and above the knees, slight tilt of the frame, candid photo. Without clear detail of the face, look into the camera, studio light." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_026.jpg", prompt: "Creative photo session\n\nWe generate you in a shirt against the background of a collage using this prompt:\n\n\nmodern editorial collage poster design. the background features four stacked rounded panels filled with black and white cinematic portraits of a stylish young person in different fashion poses. overlayed in the foreground is a high-quality full-color cutout of the same person wearing a red oversized shirt with black pants and sunglasses, striking a confident fashion pose. clean minimal design, no text, no typography, no letters, soft shadows, depth layering, high contrast lighting, premium magazine style, ultra realistic, 8k, professional poster composition." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_038.jpg", prompt: "Vibe of the working week\n\nWe generate a photo of the sea with a laptop and coffee using this prompt:\n\n\nRealistic candid photo of [person from uploaded photo] standing chest-deep in rough ocean\nwater, surrounded by large breaking waves and white sea foam, no hat.\nIn one raised hand, held above the water, they hold an open dark grey/space-black laptop\nwith a visible Apple logo, angled towards their face as if working on it. In the other hand,\nraised at chest height, they hold a to-go coffee cup with a white lid and brown sleeve.Their expression is focused and slightly tired, looking down at the laptop screen. Only the\nhead, shoulders, and raised arms are visible above the waterline; the rest of the body is\nsubmerged. The ocean is turbulent with rolling waves and whitewater in the background, cool grey-blue-green color grading, overcast diffused daylight, slightly moody and dramatic lighting. Shot from a\ndistance with a slight telephoto compression, as if photographed candidly from the shore.Vertical composition, photorealistic, ironic \"always working\" meme aesthetic,\nno text overlays anywhere on the image." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_039.jpg", prompt: "Alcoholism\n\nWe generate what you would look like if you had been drinking for the last 10 years using this prompt:\n\n\nEdit only the face. Keep everything else unchanged.\n\n\nMake the person look like a heavy daily alcohol drinker for 5 years: significantly bloated face, swollen cheeks, fuller jawline, puffy neck, swollen eyelids, heavy eye bags and deep under-eye puffiness, facial redness, broken capillaries around the nose and cheeks, uneven dull skin, tired bloodshot eyes, mild premature aging, softer facial contours, reduced facial definition.\n\n\nPhotorealistic, believable, clearly the same person." },
  { cat: "Moda & Beleza", slug: "moda-beleza", img: "prompt_040.jpg", prompt: "Photo of a man on a yacht\n\nLet's generate a cool photo on a yacht using this prompt:\n\n\nA confident man from reference photo stands facing the camera with a relaxed posture, his shoulders at ease and his weight leaning slightly to the left against an unseen boat railing. He has light eyes, a subtle closed smile, and neutral eyebrows, maintaining a deliberately posed, direct gaze. He wears a high-contrast, fully unbuttoned white linen shirt, his left arm extending down and out of frame, while his right arm rests tucked away, revealing only a gray wristband on his wrist. Above him in the foreground, the pristine, perfectly smooth matte off-white edge of a painted drywall boat canopy frames the top of the shot, while a new, ornate, curved baroque-style silver metallic piece enters the bottom left. Beyond the isolated subject, the expansive environment features deep blue-black choppy water in the midground, its surface ripples catching faint light reflections. The deep spatial background is dominated by a majestic suspension bridge centered in the distance, fully illuminated with vibrant vertical white light strips running down its cables, anchored by a dark, distant coastline densely dotted with warm golden-yellow and orange city lights. The breezy, energetic atmosphere of a night out on the water is defined by highly directional, bright, single-source artificial front lighting that perfectly mimics a direct camera flash. This hard light generates a dramatic, high contrast ratio, blowing out specular highlights on his forehead, the bridge of his nose, and the crisp folds of his white linen shirt, while carving harsh, deep black shadows with sharply defined edges under his chin, inside the shirt folds, and directly onto his bare chest from the collar. The cool-toned, complementary color palette effortlessly guides the eye from his brilliantly lit face and warm skin tone back toward the colorful bridge, leaving absolutely no ambient fill light to soften the dark night. Captured as a realistic digital photograph with clear influences from travel lifestyle nightlife imagery, the shot utilizes a straight-on perspective, boasting tack-sharp focus on the subject and noticeable digital noise grain across the deep background. The deep depth of field retains clarity across the entire seascape and cityscape, enhanced by contrast adjustments, a lowered black point, flash exposure compensation, and subtle color grading to boost the vivid background lights, with the entire composition ultimately framed in a 4:5 aspect ratio." },
  { cat: "Objetos & Arte", slug: "objetos-arte", img: "prompt_001.jpg", prompt: "Beautiful infographics\n\nWe create a beautiful illustration on any of your topics using this prompt:\n\nCreate a high-level vertical illustration in the style of the Cutaway Educational Picture Book, a modern educational cutaway book. It should not be just a diagram or a realistic atlas, but a fascinating educational illustration that simultaneously shows the external shape of the object, internal structure, functional areas, operating principle and key knowledge.\n\nText in Russian.\n\nSubject\nHOW THE HEART WORKS\n\nAutomatic interpretation\nChoose the best way to visualize your theme yourself:\n\n* determine the object type;\n* select the main emphasis: structure, functions, operating principles, flows, zones or connections;\n* focus on the level \u201cunderstandable for children, interesting for adults\u201d;\n* if a strict cut is not suitable, use translucency, local section, layer-by-layer opening or enlarged fragments.\n\nFormat and composition\nVertical format 3:4.\n\nThe main object is large in the center, making the most efficient use of height. The external silhouette and internal structure must be read simultaneously.\n\nExplanations, arrows, enlarged details and information blocks should be distributed around the object. The composition should be rich but clear, balanced and easy to read on a vertical screen.\n\nContent\n\n* The object is recognizable at first sight.\n* Internal structures and functional areas are clearly separated.\n*Each key area has educational value.\n* Show the principle of operation and the relationship of parts.\n* Small characters or mini-scenes are acceptable to enliven the page.\n* Use arrows, numbering, short captions, facts and enlarged sections.\n* Lots of information, but without visual chaos.\n\nVisual style\nContemporary high quality children's non-fiction illustration:\n\n* natural lines of hand drawing;\n* soft book contours;\n* bright, clean and friendly palette;\n* high detail without overload;\n* clear structure without engineering rigidity;\n* balance between book illustration and infographics;\n* modern, fresh, professional look.\n\nTexture\nNo imitation of physical paper.\n\nDo not use:\n\n* paper texture;\n* printing noise;\n* aging;\n* folds, book seams;\n* strong graininess;\n* yellow tint of an old book.\n\nThe image should look like a modern digital page from a non-fiction book.\n\nText and markup\nShort Russian captions and explanations should be seamlessly integrated into the composition and aid understanding without obscuring the main subject.\n\nColor\nColors are automatically selected to match the theme:\nbright, soft, clean, with clear separation of layers and moderate accents.\n\nDon't create\n\n* realistic medical atlas;\n* industrial drawing;\n* a primitive children's picture;\n* decorative poster without explanation;\n* chaotic infographics;\n* cyberpunk interface;\n* aesthetics of an old or scanned book.\n\nGoal\nTo create a beautiful, detailed and easy to read page of a modern popular science book that both explains the structure and principle of the heart and makes you want to look at the details for a long time." },
  { cat: "Objetos & Arte", slug: "objetos-arte", img: "prompt_002.jpg", prompt: "GTA VI processing\n\nLet's turn your regular photo into a GTA VI game frame using this prompt:\n\n\nTransform this exact image into a cinematic visual inspired by Grand Theft Auto VI. Preserve the original composition, facial features, pose, and subject identity while enhancing it with a polished next-generation video game aesthetic.\nApply hyper-realistic rendering with cinematic lighting, HDR effects, detailed skin textures and natural imperfections (not cartoonish), subtle stylization inspired by GTA VI character design, vibrant but controlled color grading (Miami/Vice City-inspired tones, warm highlights, teal shadows), depth of field and environmental atmosphere for immersion, clean, sharp focus with AAA video game quality.\nUse a grounded semi-realistic style inspired by GTA VI character design \u2014 modern, refined, and immersive, without exaggerated or comic-like features. Add balanced Miami/Vice City-inspired color grading with warm highlights, teal shadows, neon ambience, and atmospheric depth.\nInclude realistic depth of field and sharp AAA-quality focus to create the feel of a high-budget open-world game cutscene.\nIf applicable, enhance the background with a modern Vice City vibe, including neon lights, palm trees, luxury urban scenery, reflective streets, and cinematic sunset or night lighting.\nImportant requirements:\n\u2022 Do not convert into cartoon, comic, cel-shaded, or GTA V-style art\n\u2022 Avoid thick outlines or unrealistic proportions\n\u2022 Keep the subject recognizable and authentic\n\u2022 Maintain realism with only subtle stylization\nA realistic GTA VI-inspired render that looks like a character from a modern AAA open-world game." },
  { cat: "Objetos & Arte", slug: "objetos-arte", img: "prompt_003.jpg", prompt: "Balloon font\n\nWe generate a beautiful font from balloons using this prompt:\n\n\nUltra-inflated glossy latex typography spelling \u201c[TEXT]\u201d, each letter constructed from oversized pneumatic balloon forms, tightly compressed together with visible tension wrinkles, pressure folds, stretched seams, and soft air-filled deformation.\n\n[INSERT COLOUR] rubber material with intense specular highlights and realistic reflective shine.\nLetters appear squashed and inflated simultaneously, creating an organic soft-body typography effect. [INSERT COLOUR] studio background.\n\nMinimalist experimental poster design. Macro studio lighting with strong reflections and deep shadows. Cinematic glossy texture, subtle surface imperfections, photorealistic soft-body simulation, inflated vinyl aesthetic, modern Blender 3D typography render, ultra-clean composition, centered framing, premium graphic design aesthetic, tactile rubber realism, high-detail compression artifacts, smooth rounded edges, abstract inflatable type sculpture.\n\n\n\n\nP" },
  { cat: "Objetos & Arte", slug: "objetos-arte", img: "prompt_004.jpg", prompt: "We bend reality\n\nWe generate a reality distortion effect in your photo using this prompt:\n\n\nTransform the uploaded image into a premium pixel stretch digital artwork while keeping the main subject perfectly sharp, detailed, and recognizable. Preserve the original identity, silhouette, lighting, and composition of the subject. Extract the colors, textures, and atmosphere from the image and extend them outward into smooth, flowing pixel-stretch ribbons that follow elegant curves and dynamic motion. Create seamless transitions between the original photo and the stretched areas, with no glitches, broken pixels, or harsh edges. The stretched pixels should look silky, fluid, and organic \u2014 like streams of color, light, paint, smoke, or energy flowing through the scene. Maintain realistic depth, shadows, reflections, and natural lighting. Enhance the image with cinematic contrast, vibrant HDR colors, ultra-sharp details, and a luxury digital art aesthetic. Style: Adobe Photoshop pixel stretch effect, liquid motion blur, flowing light trails, abstract energy waves, gallery-quality digital artwork, modern minimalist composition, cinematic photography, 8K ultra-high resolution, premium social media masterpiece. Keep the subject untouched and crystal clear while the environment transforms into artistic flowing motion." },
  { cat: "Objetos & Arte", slug: "objetos-arte", img: "prompt_008.jpg", prompt: "Odyssey\n\nLet\u2019s transform your appearance into a character from the acclaimed film \u201cOdyssey\u201d using this prompt:\n\n\nCinematic film still, low-angle medium close-up of [a person matching my uploaded reference photo] as an imposing ancient warrior. The subject wears a matte-black stylized Corinthian helmet with a tall black bristled crest, dark shoulder armor, and a thick black cape fastened by a dull gold circular medallion. Only the lower face and eyes are visible beneath the helmet, showing a stoic, serious expression while looking slightly downward. In the heavily blurred foreground on the right, the curved, faded red bristled crest of another helmet intrudes into the frame. The background consists of a soft, muted overcast blue-grey sky with faint diagonal ship rigging ropes visible on the far right. Soft diffused daylight, cool desaturated cinematic color grading, low contrast, 35mm film grain emulation, shallow depth of field, epic mythological mood, highly detailed, photorealistic, 8k. 4:5 Aspect ratio." },
  { cat: "Paisagens & Cidades", slug: "paisagens-cidades", img: "prompt_001.jpg", prompt: "Photos in nature\n\nWe generate an aesthetic photo against the backdrop of mountains and a river using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. A girl stands on a hillside against the backdrop of a picturesque valley with a winding river, dense green hills and forests. Profile, slight smile, gaze downward. The arms are spread wide apart, the pose conveys freedom and delight. Voluminous flowing hair, a few strands falling on the face. Light makeup: long eyelashes, lips with a clear contour and shine. Tanned glowing skin. White tight sports long sleeve and graphite sports leggings. In the foreground there is green grass and field plants, in the distance there is a panorama of the valley with a smooth bend of the river. Clear blue sky with large voluminous white clouds. Golden hour, warm backlight highlights hair strands and silhouette. Ultra-realistic premium lifestyle shot, live photo without retouching, natural skin details, cinematic depth and high detail." },
  { cat: "Paisagens & Cidades", slug: "paisagens-cidades", img: "prompt_002.jpg", prompt: "Photo with snowboard\n\nLet's generate a cool photo of snow-capped mountains on a snowboard using this prompt:\n\n\nA dynamic action shot of a snowboarder from the attached image with a hairstyle as shown in the photo wearing a modest, structured red-and-white patterned athletic top with extended coverage, matching winter snowboarding pants, and a gray backpack, carving swiftly down a steep, sunlit snowy mountain slope under a brilliant blue sky, kicking up a dramatic spray of powdery snow crystals with cinematic lighting." },
  { cat: "Paisagens & Cidades", slug: "paisagens-cidades", img: "prompt_003.jpg", prompt: "Night photo\n\nWe generate a beautiful night photo in the city using this prompt:\n\n\nMaintain appearance 100%. Do not change facial features or proportions. Night street-style shot with flash. The girl turns her back halfway, looking over her right shoulder at the camera. A messy high bun with strands near the face. White strapless top, linen shirt dropped off the shoulders, wide light blue jeans, red bag. Fox eyelashes, arrows, laminated eyebrows, matte pink lips, long square jacket. Night street with lanterns, shop windows and \"P\" sign. Paparazzi flash, candid, high detail, 8K." },
  { cat: "Paisagens & Cidades", slug: "paisagens-cidades", img: "prompt_004.jpg", prompt: "Chase in the desert\n\nWe generate a photo of you driving in the desert using this prompt:\n\n\nCreate an ultra-photorealistic 8K UHD RAW HDR automotive editorial photograph of a 1969 first-generation Chevrolet Camaro, glossy black body with a clean white roof, performing an aggressive high-speed powerslide on an open desert dirt road. Thick realistic dust erupts from the rear tires with natural turbulence, flying gravel and sharp tire tracks conveying extreme speed.\n\nA young male driver leans toward the open window, left arm casually resting on the door, right hand gripping the wheel. His face is clearly visible, sharp and unobstructed, eyes focused forward, calm confident expression, windblown hair, natural skin texture. No reflections, shadows, or glass obstructing his face.\n\nComposition: vertical 3:4, dramatic high-angle aerial front 3/4 view from approximately 45\u201370\u00b0 above, as if tracked by a drone. Car fills 75\u201380% of frame, white roof clearly visible, massive dust trail behind it, slight negative space ahead to emphasize motion.\n\nLighting: golden-hour sunset, warm directional light on the car and driver, subtle natural rim light, realistic glossy reflections, long dramatic shadows, perfectly balanced facial exposure.\n\nLook: premium automotive editorial photography, cinematic Kodak Portra 400 aesthetic, warm earthy tones, golden highlights, slightly cool shadows, natural saturation, medium contrast, high dynamic range, subtle analog film grain.\n\nVehicle: authentic 1969 Camaro proportions, pristine glossy black paint, white roof, classic five-spoke racing wheels, realistic torque deformation on rear tires, dust on lower body, crisp chrome and body-line details.\n\nCamera: Sony A1 II, FE 50mm f/1.2 GM, 50mm, f/2.8, 1/2500s, ISO 200, continuous AF, tracking/panning. Ultra-sharp focus on driver\u2019s face, hands, roof and front body; natural motion blur only on wheels and dust.\n\nEnvironment: vast barren desert landscape, clear warm sky, unobstructed horizon, cinematic atmospheric dust.\n\nQuality: physically accurate lighting, realistic reflections, natural skin, authentic vehicle materials, realistic dust simulation, true-to-life motion physics, hyper-detailed, cinematic, premium editorial, IMAX-quality realism.\n\nNegative: CGI, cartoon, anime, AI artifacts, low resolution, oversaturated colors, overprocessed HDR, blurry/obscured face, reflective glass over face, distorted car, warped panels, duplicated wheels, unrealistic dust, deformed hands/face, plastic skin, excessive sharpening, watermark, text, logo, cropped vehicle, out of frame, compression artifacts, ghosting." },
  { cat: "Paisagens & Cidades", slug: "paisagens-cidades", img: "prompt_014.jpg", prompt: "50%\nDETAILED PROMPT\n\n\nVersion Midjourney: 8.1\nPrompt: countryside landscape in the style of David Hockney, rolling green hills, winding forest path, scattered farmhouses, fields with bright contrasting colors, tall tree in the center of the scene, horse standing beneath the tree, small stream winding through, cloudy sky with rain falling, wet surfaces, soft reflections, vibrant palette, bold lines, flat perspective, watercolor painting texture\n\n\nMidjourney Bot\n\n\n\nJoin: @Midjourneyai1\u00a0| Boost" },
  { cat: "Produtos & Publicidade", slug: "produtos-publicidade", img: "prompt_001.jpg", prompt: "Beautiful photos of your product\n\nWe generate your product with a beautiful background of your choice using this prompt:\n\n\nExtreme close-up overhead shot of [product from uploaded photo] nestled in the center of a dense pile of fresh ripe tomatoes with green stems, soft natural directional lighting creating gentle highlights and shadows on both the product and the surrounding tomatoes, shallow depth of field, product sharply in focus and slightly elevated above the produce, seamless organic surrounding pattern filling the entire frame with no visible background, high-end editorial product photography, hyperrealistic texture contrast between glossy tomato skin and product surface" },
  { cat: "Produtos & Publicidade", slug: "produtos-publicidade", img: "prompt_002.jpg", prompt: "Promo of your product\n\nWe generate a very creative advertisement for your product using this prompt:\n\n\nClose-up macro shot of furry gloved hands in magenta pink fur with gold pointed nail tips, wearing an oversized green fleece coat, holding [subject from uploaded photo] up close to the camera, playful maximalist fashion editorial style, bold saturated colors, glossy gold jewelry details on the fur, soft studio lighting, high-fashion food photography, vibrant contrast between pink, green and gold" },
  { cat: "Produtos & Publicidade", slug: "produtos-publicidade", img: "prompt_003.jpg", prompt: "Advertising poster\n\nWe generate an advertising poster for any of your products using this prompt:\n\n\nUse the uploaded product image as the single source of truth and create one outstanding vertical ad ready for a premium campaign.\nProduct Analysis\nSilently determine the category, function, audience, price segment, brand character, materials, colors, packaging, typography, logo, and main product advantage. Base all decisions solely on the photo reference.\nProduct DNA Protection\nPreserve the product 1:1: shape, proportions, packaging, logo, label, text, colors, materials, textures, finish, reflections, and all visible details. Do not alter, repaint, simplify, duplicate, or add fictional elements.\nCreative Selection\nSilently develop 5 ad concepts, evaluate them based on originality, brand alignment, realism, visual power, and product focus. Show only the strongest final concept.\nBrand Communication\nAdd:\n\u2014 brand logo or name;\n\u2014 one slogan of maximum 3 words;\n\u2014 one short additional phrase if necessary.\nLanguage \u2014 Russian or the brand's language. Typography must exactly match its style. Minimum text, no long explanations.\nVisual Direction\nBold, cinematic, and premium composition with the product as the main character. Realistic lighting, refined shadows, strong visual hierarchy, and thoughtful negative space.\nNo infographics, callouts, comparisons, extra icons, fake UI, visual noise, or random effects.\nResult: one clean vertical ad 4:5, only the final best version, no analysis." },
  { cat: "Produtos & Publicidade", slug: "produtos-publicidade", img: "prompt_004.jpg", prompt: "Promo of your product\n\nCreative advertising of your product in volleyball style using this prompt:\n\n\nDynamic playful product photography of [product from uploaded photo] frozen mid-air over a volleyball net, being spiked/hit by two diverse hands reaching from opposite sides of the net, solid vivid blue background with visible water splash/spray texture, bright saturated studio lighting, high-energy sports-ad composition, slight motion blur on the net strap, product sharply in focus, colorful bracelets and nail polish visible on one hand for a fun candid touch, bold graphic advertising aesthetic, high-resolution commercial photography, square or portrait crop" },
];

  const CATEGORY_SLUGS = {
    'Comida & Bebida': 'comida-bebida',
    'Moda & Beleza': 'moda-beleza',
    'Produtos & Publicidade': 'produtos-publicidade',
    'Paisagens & Cidades': 'paisagens-cidades',
    'Animais': 'animais',
    'Icones & UI': 'icones-ui',
    'Objetos & Arte': 'objetos-arte'
  };

  const galleryData = promptData.map((item, index) => ({
    img: `prompts/${encodeURIComponent(item.cat)}/${item.img}`,
    cat: item.cat,
    slug: CATEGORY_SLUGS[item.cat] || 'outros',
    prompt: item.prompt
  })).concat(promptDataPago.map((item) => ({
    img: `prompts/pago/${encodeURIComponent(item.slug)}/${item.img}`,
    cat: item.cat,
    slug: item.slug,
    prompt: item.prompt
  })));

  const galleryItems = [];

  function createGalleryCard(item, index) {
    const card = document.createElement('div');
    card.className = 'gallery-item has-image';
    card.dataset.tag = item.slug;
    card.innerHTML = `
      <div class="gallery-item-image">
        <img src="${item.img}" alt="${item.cat} - Prompt ${String(index + 1).padStart(3, '0')}" loading="lazy">
      </div>
      <div class="gallery-item-prompt-top">
        <span class="prompt-top-tag">${item.cat}</span>
        <span class="prompt-top-name">Prompt #${String(index + 1).padStart(3, '0')}</span>
      </div>
      <div class="gallery-item-prompt-bottom">
        <p>${item.prompt}</p>
      </div>
    `;
    card.addEventListener('click', () => {
      currentIndex = index;
      openLightbox();
    });
    galleryItems.push(card);
    return card;
  }

  const fragment = document.createDocumentFragment();
  galleryData.forEach((item, index) => {
    fragment.appendChild(createGalleryCard(item, index));
  });
  galleryGrid.appendChild(fragment);

  if (galleryCount) {
    galleryCount.textContent = `+${galleryData.length} prompts exclusivos`;
  }

  // === GALLERY STAGGER ANIMATION ===
  const galleryObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'scale(1)';
        }, index * 50);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.gallery-item').forEach(item => {
    item.style.opacity = '0';
    item.style.transform = 'scale(0.95)';
    item.style.transition = 'all 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    galleryObserver.observe(item);
  });

  // === GALLERY LIGHTBOX ===
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightboxImage');
  const lightboxTag = document.getElementById('lightboxTag');
  const lightboxPrompt = document.getElementById('lightboxPrompt');
  const lightboxCounter = document.getElementById('lightboxCounter');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');
  const lightboxCopy = document.getElementById('lightboxCopy');
  let currentIndex = 0;

  function openLightbox() {
    const data = galleryData[currentIndex];
    if (!data) return;
    lightboxImage.src = data.img;
    lightboxTag.textContent = data.cat;
    lightboxPrompt.textContent = data.prompt;
    lightboxCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(galleryData.length).padStart(2, '0')}`;
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % galleryData.length;
    openLightbox();
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + galleryData.length) % galleryData.length;
    openLightbox();
  }

  lightboxClose.addEventListener('click', closeLightbox);
  lightboxNext.addEventListener('click', nextImage);
  lightboxPrev.addEventListener('click', prevImage);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(lightboxPrompt.textContent).then(() => {
      lightboxCopy.textContent = 'Copiado!';
      setTimeout(() => lightboxCopy.textContent = 'Copiar Prompt', 2000);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
  });

  // === GALLERY FILTER ===
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      galleryItems.forEach(item => {
        const tag = item.dataset.tag;
        if (filter === 'all' || tag.includes(filter)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // === STICKY CTA ===
  const stickyCta = document.getElementById('stickyCta');
  const gallerySection = document.getElementById('biblioteca');
  
  window.addEventListener('scroll', () => {
    if (!gallerySection || !stickyCta) return;
    const galleryRect = gallerySection.getBoundingClientRect();
    if (galleryRect.top < 0) {
      stickyCta.classList.add('visible');
    } else {
      stickyCta.classList.remove('visible');
    }
  });

  // === ACCESS GRANTED MODAL ===
  window.openAccessGranted = function () {
    const modal = document.getElementById('accessModal');
    if (!modal) return;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    const bar = modal.querySelector('.access-bar-fill');
    if (bar) {
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    }
  };
  window.closeAccessGranted = function () {
    const modal = document.getElementById('accessModal');
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
  };

  // === UNLOCK MODAL ===
  function showUnlockModal() {
    const modal = document.createElement('div');
    modal.className = 'unlock-modal';
    modal.innerHTML = `
      <div class="unlock-modal-content">
        <button class="unlock-modal-close">✕</button>
        <h3>Desbloqueie Acesso Completo</h3>
        <p>+1000 prompts e +500 sites de IA por apenas R$34,90</p>
        <div class="unlock-modal-pix">
          <div class="unlock-modal-qr">
            <img src="images/pix/qrcode-pix.png" alt="QR Code Pix">
          </div>
          <p class="unlock-modal-pix-label">Chave Pix (Mercado Pago):</p>
          <div class="unlock-modal-pix-key">
            <span>bac9d837-e097-407c-9461-173d0c922e6f</span>
            <button class="unlock-modal-pix-copy" onclick="navigator.clipboard.writeText('bac9d837-e097-407c-9461-173d0c922e6f')">Copiar</button>
          </div>
        </div>
        <div class="unlock-modal-buttons">
          <button class="btn btn-primary" onclick="openAccessGranted()">Ja paguei, liberar acesso</button>
          <a href="#precos" class="btn btn-ghost">Ver detalhes</a>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    
    setTimeout(() => modal.classList.add('active'), 10);
    
    modal.querySelector('.unlock-modal-close').addEventListener('click', () => {
      modal.classList.remove('active');
      setTimeout(() => modal.remove(), 300);
    });
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        setTimeout(() => modal.remove(), 300);
      }
    });
  }

  // Add click to unlock on locked gallery items only
  document.querySelectorAll('.gallery-item:not(.has-image)').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      showUnlockModal();
    });
  });

  // === FULL-PAGE FOG ===
  const fogCanvas = document.getElementById('pageFog');
  if (fogCanvas) {
    const fctx = fogCanvas.getContext('2d');
    const fogPrefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function sizeFogCanvas() {
      fogCanvas.width = window.innerWidth;
      fogCanvas.height = window.innerHeight;
    }
    sizeFogCanvas();
    window.addEventListener('resize', debounce(sizeFogCanvas, 150));

    const fogPuffsFull = [];
    for (let i = 0; i < 12; i++) {
      fogPuffsFull.push({
        x: rand(0, fogCanvas.width),
        y: rand(0, fogCanvas.height),
        vx: rand(-0.4, 0.4),
        vy: rand(-0.25, 0.25),
        r: rand(140, 320),
        phase: rand(0, Math.PI * 2),
        color: ['rgba(0,128,160,', 'rgba(0,96,128,', 'rgba(0,160,192,', 'rgba(0,96,96,', 'rgba(0,64,96,', 'rgba(0,128,192,', 'rgba(0,192,192,', 'rgba(0,80,128,', 'rgba(0,144,176,', 'rgba(0,112,144,', 'rgba(0,176,208,', 'rgba(0,72,112,'][i % 12]
      });
    }

    function drawFog(t) {
      const w = fogCanvas.width, h = fogCanvas.height;
      fctx.clearRect(0, 0, w, h);
      fctx.globalCompositeOperation = 'lighter';
      fogPuffsFull.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -p.r) p.x = w + p.r;
        if (p.x > w + p.r) p.x = -p.r;
        if (p.y < -p.r) p.y = h + p.r;
        if (p.y > h + p.r) p.y = -p.r;
        const swell = 1 + Math.sin(t * 0.0015 + p.phase) * 0.25;
        const g = fctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * swell);
        g.addColorStop(0, p.color + '0.16)');
        g.addColorStop(0.5, p.color + '0.07)');
        g.addColorStop(1, p.color + '0)');
        fctx.fillStyle = g;
        fctx.beginPath();
        fctx.arc(p.x, p.y, p.r * swell, 0, Math.PI * 2);
        fctx.fill();
      });
      fctx.globalCompositeOperation = 'source-over';
    }

    if (!fogPrefersReduced) {
      let fogStart = performance.now();
      (function fogAnim(now) {
        drawFog(now - fogStart);
        requestAnimationFrame(fogAnim);
      })(performance.now());
    }
  }

  // === LOGO ELECTRIFY ===
  const logoEls = document.querySelectorAll('.nav-logo');
  logoEls.forEach((logo) => {
    const img = logo.querySelector('.nav-logo-img');
    if (!img || logo.querySelector('.logo-electrify')) return;
    const canvas = document.createElement('canvas');
    canvas.className = 'logo-electrify';
    logo.appendChild(canvas);
    const lctx = canvas.getContext('2d');

    function sizeLogoCanvas() {
      const logoRect = logo.getBoundingClientRect();
      const imgRect = img.getBoundingClientRect();
      const pad = 60;
      const left = imgRect.left - logoRect.left - pad;
      const top = imgRect.top - logoRect.top - pad;
      const w = imgRect.width + pad * 2;
      const h = imgRect.height + pad * 2;
      canvas.width = Math.max(2, Math.round(w));
      canvas.height = Math.max(2, Math.round(h));
      canvas.style.left = Math.round(left) + 'px';
      canvas.style.top = Math.round(top) + 'px';
      return { pad };
    }
    sizeLogoCanvas();
    window.addEventListener('resize', debounce(sizeLogoCanvas, 150));

    const bolts = [];
    const sparks = [];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function spawnBolt() {
      const w = canvas.width, h = canvas.height;
      const pad = 40;
      const imgW = Math.max(20, w - pad * 2);
      const imgH = Math.max(20, h - pad * 2);
      const edge = Math.floor(Math.random() * 4);
      let x, y;
      if (edge === 0) { x = rand(pad, pad + imgW); y = pad; }
      else if (edge === 1) { x = pad + imgW; y = rand(pad, pad + imgH); }
      else if (edge === 2) { x = rand(pad, pad + imgW); y = pad + imgH; }
      else { x = pad; y = rand(pad, pad + imgH); }
      let dx = (Math.random() - 0.5) * 2;
      let dy = (Math.random() - 0.5) * 2;
      if (Math.abs(dx) + Math.abs(dy) < 0.4) { dx = 1; dy = 0; }
      const points = [{ x, y }];
      const segs = Math.floor(rand(8, 16));
      for (let i = 0; i < segs; i++) {
        if (Math.random() < 0.3) {
          dx = (Math.random() - 0.5) * 2;
          dy = (Math.random() - 0.5) * 2;
        }
        const len = rand(3, 10);
        x += dx * len;
        y += dy * len;
        points.push({ x, y });
        if (Math.random() < 0.45) {
          sparks.push({
            x, y,
            vx: dx * rand(0.5, 1.5),
            vy: dy * rand(0.5, 1.5),
            life: rand(0.6, 1)
          });
        }
      }
      bolts.push({ points, life: 1 });
      if (bolts.length > 6) bolts.shift();
    }

    function drawLogoBolt(t) {
      if (prefersReduced) {
        lctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      const w = canvas.width, h = canvas.height;
      lctx.clearRect(0, 0, w, h);
      lctx.globalCompositeOperation = 'lighter';
      bolts.forEach((bolt, bi) => {
        bolt.life -= 0.028;
        if (bolt.life <= 0) return;
        const alpha = bolt.life * 0.55;
        lctx.strokeStyle = `rgba(178,255,255,${alpha})`;
        lctx.lineWidth = 1.6;
        lctx.shadowColor = '#B2FFFF';
        lctx.shadowBlur = 16;
        lctx.beginPath();
        bolt.points.forEach((p, i) => {
          if (i === 0) lctx.moveTo(p.x, p.y);
          else lctx.lineTo(p.x, p.y);
        });
        lctx.stroke();
        lctx.strokeStyle = `rgba(0,255,136,${alpha * 0.8})`;
        lctx.lineWidth = 0.7;
        lctx.shadowColor = '#00ff88';
        lctx.shadowBlur = 22;
        lctx.stroke();
      });
      sparks.forEach((s) => {
        s.life -= 0.03;
        if (s.life <= 0) return;
        s.x += s.vx;
        s.y += s.vy;
        s.vx *= 0.94;
        s.vy *= 0.94;
        lctx.beginPath();
        lctx.arc(s.x, s.y, 1.4 * s.life, 0, Math.PI * 2);
        lctx.fillStyle = `rgba(178,255,255,${s.life * 0.6})`;
        lctx.shadowColor = '#B2FFFF';
        lctx.shadowBlur = 10;
        lctx.fill();
      });
      lctx.shadowBlur = 0;
      lctx.globalCompositeOperation = 'source-over';
      // limpar faíscas mortas
      for (let i = sparks.length - 1; i >= 0; i--) if (sparks[i].life <= 0) sparks.splice(i, 1);
      for (let i = bolts.length - 1; i >= 0; i--) if (bolts[i].life <= 0) bolts.splice(i, 1);
    }

    if (!prefersReduced) {
      setInterval(() => {
        const n = Math.random() < 0.4 ? 2 : 1;
        for (let i = 0; i < n; i++) if (Math.random() < 0.65) spawnBolt();
      }, 220);
      let logoStart = performance.now();
      (function logoAnim(now) {
        const t = now - logoStart;
        drawLogoBolt(t);
        requestAnimationFrame(logoAnim);
      })(performance.now());
    }
  });

  // === LOGO 3D ORBIT (cursorOrbit) ===
  const navLogo = document.querySelector('.nav-logo');
  const logo3d = document.querySelector('.logo-3d');
  if (navLogo && logo3d && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let orbitTargetX = 0, orbitTargetY = 0, orbitCurX = 0, orbitCurY = 0, orbitActive = false;
    navLogo.addEventListener('mousemove', (e) => {
      const r = navLogo.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      orbitTargetY = px * 14;
      orbitTargetX = -py * 14;
      orbitActive = true;
    });
    navLogo.addEventListener('mouseleave', () => {
      orbitTargetX = 0;
      orbitTargetY = 0;
      orbitActive = false;
    });
    (function orbitLoop() {
      const k = 0.12;
      orbitCurX += (orbitTargetX - orbitCurX) * k;
      orbitCurY += (orbitTargetY - orbitCurY) * k;
      logo3d.style.transform = `rotateX(${orbitCurX.toFixed(2)}deg) rotateY(${orbitCurY.toFixed(2)}deg) translateY(${orbitActive ? 0 : -4}px)`;
      logo3d.style.animation = orbitActive ? 'none' : '';
      requestAnimationFrame(orbitLoop);
    })();
  }

  // === HERO CONSTELLATION ===
  const heroField = document.getElementById('heroField');
  const heroMouseLight = document.getElementById('heroMouseLight');
  if (heroField) {
    const fctx = heroField.getContext('2d');
    let stars = [];
    let fmouse = { x: -9999, y: -9999 };
    const COUNT = 70;

    function resizeHero() {
      const hero = document.querySelector('.hero');
      const rect = hero.getBoundingClientRect();
      heroField.width = rect.width;
      heroField.height = rect.height;
      stars = [];
      for (let i = 0; i < COUNT; i++) {
        stars.push({
          x: Math.random() * rect.width,
          y: Math.random() * rect.height,
          r: Math.random() * 1.4 + 0.4,
          sx: (Math.random() - 0.5) * 0.18,
          sy: (Math.random() - 0.5) * 0.18,
          tw: Math.random() * Math.PI * 2
        });
      }
    }
    resizeHero();
    window.addEventListener('resize', debounce(resizeHero, 150));

    function drawHero() {
      const w = heroField.width;
      const h = heroField.height;
      fctx.clearRect(0, 0, w, h);
      stars.forEach(s => {
        s.x += s.sx;
        s.y += s.sy;
        if (s.x < 0 || s.x > w) s.sx *= -1;
        if (s.y < 0 || s.y > h) s.sy *= -1;
        s.tw += 0.02;
        const alpha = 0.25 + Math.abs(Math.sin(s.tw)) * 0.35;
        fctx.beginPath();
        fctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        fctx.fillStyle = `rgba(178,255,255,${alpha})`;
        fctx.fill();
      });
      // connect stars to each other
      for (let i = 0; i < stars.length; i++) {
        for (let j = i + 1; j < stars.length; j++) {
          const dx = stars[i].x - stars[j].x;
          const dy = stars[i].y - stars[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 130) {
            fctx.beginPath();
            fctx.strokeStyle = `rgba(0,135,189,${0.1 * (1 - dist / 130)})`;
            fctx.lineWidth = 0.5;
            fctx.moveTo(stars[i].x, stars[i].y);
            fctx.lineTo(stars[j].x, stars[j].y);
            fctx.stroke();
          }
        }
        // connect to mouse
        const md = Math.sqrt((stars[i].x - fmouse.x) ** 2 + (stars[i].y - fmouse.y) ** 2);
        if (md < 170) {
          fctx.beginPath();
          fctx.strokeStyle = `rgba(0,255,136,${0.35 * (1 - md / 170)})`;
          fctx.lineWidth = 0.8;
          fctx.moveTo(stars[i].x, stars[i].y);
          fctx.lineTo(fmouse.x, fmouse.y);
          fctx.stroke();
        }
      }
      requestAnimationFrame(drawHero);
    }
    drawHero();

    if (heroMouseLight) {
      document.addEventListener('mousemove', (e) => {
        const hero = document.querySelector('.hero');
        const rect = hero.getBoundingClientRect();
        const lx = e.clientX - rect.left;
        const ly = e.clientY - rect.top;
        fmouse.x = lx;
        fmouse.y = ly;
        if (rect.top < e.clientY && rect.bottom > e.clientY && rect.left < e.clientX && rect.right > e.clientX) {
          heroMouseLight.style.opacity = '1';
        } else {
          heroMouseLight.style.opacity = '0';
        }
        heroMouseLight.style.left = lx + 'px';
        heroMouseLight.style.top = ly + 'px';
      });
    }
  }

  // === HERO TYPING EFFECT ===
  const heroTitle = document.getElementById('heroTitle');
  if (heroTitle) {
    const words = Array.from(heroTitle.querySelectorAll('.hero-word'));
    const lines = Array.from(heroTitle.querySelectorAll('.hero-line'));
    const heroCursor = document.getElementById('heroCursor');

    const originals = words.map(w => w.dataset.text || w.textContent);

    let li = 0, ci = 0, lastT = 0;
    const speed = 120;

    words.forEach(w => { w.textContent = ''; });
    heroTitle.classList.add('is-anim');

    function type(timestamp) {
      if (!lastT) lastT = timestamp;
      const elapsed = timestamp - lastT;
      if (elapsed >= speed) {
        lastT = timestamp;
        const current = originals[li];
        ci++;
        words[li].textContent = current.slice(0, ci);
        if (ci >= current.length) {
          ci = 0;
          li++;
          if (li >= originals.length) {
            heroTitle.classList.add('typed');
            return;
          }
        }
      }
      requestAnimationFrame(type);
    }
    setTimeout(() => requestAnimationFrame(type), 1200);
  }
  const hero = document.querySelector('.hero');
  let lastScrollY = window.pageYOffset;
  window.addEventListener('scroll', debounce(() => {
    if (!hero) return;
    const y = window.pageYOffset;
    const heroBottom = hero.offsetTop + hero.offsetHeight;
    if (y < heroBottom) {
      hero.classList.toggle('is-scrolling-up', y < lastScrollY);
      hero.classList.toggle('is-scrolling-down', y > lastScrollY);
    }
    lastScrollY = y;
  }, 40));
});
